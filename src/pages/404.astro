---
import Base from '../layouts/Base.astro';
import { url } from '../i18n';
---

<Base lang="en" path="" title="404">
  <section class="container-x grid min-h-[70vh] place-items-center pt-32 text-center">
    <div>
      <p class="kicker justify-center">404</p>
      <h1 class="h-section mt-5">Page not found</h1>
      <p class="mt-4 text-lg text-muted" dir="rtl" lang="ar">الصفحة غير موجودة</p>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href={url('en/')} class="btn btn-primary">Go home</a>
        <a href={url('ar/')} class="btn btn-ghost" lang="ar">الرئيسية</a>
      </div>
    </div>
  </section>
</Base>
