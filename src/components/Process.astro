---
import SectionHead from './SectionHead.astro';
import { processSteps } from '../data/site';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const num = (i: number) => String(i + 1).padStart(2, '0');
---

<section id="process" class="relative py-24 sm:py-32" aria-labelledby="process-title">
  <div class="container-x">
    <SectionHead kicker={s.process.kicker} title={s.process.title} id="process-title" />
    <div class="relative mt-14">
      <ol class="grid gap-5 md:grid-cols-2 lg:grid-cols-5">
      {
        processSteps.map((st, i) => (
          <li class="card relative p-6" style={`--d:${i}`} data-reveal>
            <span class="relative z-10 grid size-11 place-items-center rounded-full border border-line bg-bg-2 font-display text-sm font-bold text-brand-ink shadow-[0_0_0_6px_var(--bg)]">
              {num(i)}
            </span>
            <h3 class="mt-6 font-display text-xl font-semibold tracking-tight">{st.title[lang]}</h3>
            <p class="mt-3 text-[0.95rem] leading-relaxed text-muted">{st.body[lang]}</p>
          </li>
        ))
      }
      </ol>
    </div>
  </div>
</section>
