---
import ProjectMarquee from './ProjectMarquee.astro';
import Icon from './Icon.astro';
import Img from './Img.astro';
import { t, type Lang } from '../i18n';
import { links, profile, stats } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const [first, ...rest] = profile.name[lang].split(' ');
const fmt = (n: number) => String(n);
---

<section id="top" class="relative overflow-x-clip pt-[calc(4.5rem+env(safe-area-inset-top))] lg:pt-36" aria-labelledby="hero-title">
  <div class="container-x grid items-center gap-12 lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-7">
      <!-- Phones / tablets: compact profile header, like an app's account screen -->
      <div class="rise flex items-center gap-4 lg:hidden" style="--d:0">
        <div class="relative size-[5.75rem] shrink-0 sm:size-28">
          <div class="ring-spin absolute -inset-[2px] rounded-[1.7rem]" aria-hidden="true"></div>
          <div class="relative size-full overflow-hidden rounded-[1.6rem] border border-white/10 bg-bg-2">
            <Img src="ANaSHaker/assets/_src/photo.jpg" alt={s.hero.photoAlt} sizes="120px" eager class="size-full scale-[1.12] object-cover object-[50%_25%]" />
          </div>
          <span class="absolute -bottom-1 -end-1 grid size-6 place-items-center rounded-full border-[3px] border-bg bg-emerald-500" aria-hidden="true">
            <span class="pulse-dot size-2 rounded-full bg-white"></span>
          </span>
        </div>
        <div class="min-w-0">
          <p class="font-display text-[0.95rem] font-semibold text-brand-ink">{profile.role[lang]}</p>
          <p class="mt-1 flex items-center gap-1.5 text-[0.9rem] text-muted">
            <Icon name="map" size={15} />
            {profile.city[lang]}
          </p>
        </div>
      </div>

      <p class="rise kicker hidden lg:inline-flex" style="--d:0">
        <span class="relative inline-flex size-2 rounded-full bg-emerald-500 pulse-dot" aria-hidden="true"></span>
        {s.hero.eyebrow}
      </p>
      <h1
        id="hero-title"
        class:list={[
          'rise mt-5 font-display font-bold text-ink lg:mt-6',
          lang === 'ar'
            ? 'text-[clamp(2.7rem,10vw,6.5rem)] leading-[1.15]'
            : 'text-[clamp(2.9rem,10.5vw,7.6rem)] leading-[0.95] tracking-[-0.045em]',
        ]}
        style="--d:1"
      >
        <span class="block">{first}</span>
        <span class="text-gradient block pb-1">{rest.join(' ')}</span>
      </h1>
      <p class="rise mt-4 max-w-xl text-[1.05rem] leading-relaxed text-ink-2 sm:mt-6 sm:text-xl" style="--d:2">
        {profile.tagline[lang]}
      </p>
      <div class="rise mt-6 flex items-center gap-2.5 sm:mt-9 sm:flex-wrap sm:gap-3" style="--d:3">
        <a href={links.whatsapp} target="_blank" rel="noopener" class="btn btn-primary min-h-12 flex-1 sm:flex-none">
          <Icon name="whatsapp" size={18} />
          {s.hero.ctaPrimary}
        </a>
        <a href={links.linkedin} target="_blank" rel="noopener" class="btn btn-ghost min-h-12 max-sm:!px-4" aria-label={s.hero.ctaSecondary}>
          <Icon name="linkedin" size={17} />
          <span class="max-sm:sr-only">{s.hero.ctaSecondary}</span>
        </a>
        <a href="#work" class="link-arrow hidden items-center gap-2 px-3 py-3 font-semibold text-ink-2 hover:text-ink sm:inline-flex">
          {s.hero.ctaWork}
          <Icon name="arrow" size={18} class="flip-rtl" />
        </a>
      </div>
    </div>

    <!-- Desktop portrait -->
    <div class="rise relative hidden w-full lg:col-span-5 lg:block" style="--d:2">
      <div class="relative mx-auto aspect-[4/5] w-full max-w-[25rem]">
        <div class="ring-spin absolute -inset-[2px] rounded-[2.6rem] opacity-90" aria-hidden="true"></div>
        <div
          class="absolute -inset-10 -z-10 rounded-full bg-[radial-gradient(closest-side,rgb(79_70_229/.45),transparent)] blur-2xl"
          aria-hidden="true"
        >
        </div>
        <div class="relative h-full overflow-hidden rounded-[2.5rem] border border-white/10 bg-bg-2">
          <Img
            src="ANaSHaker/assets/_src/photo.jpg"
            alt={s.hero.photoAlt}
            sizes="420px"
            class="h-full w-full scale-[1.12] object-cover object-[50%_30%]"
          />
          <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-[#05070f]/85 to-transparent" aria-hidden="true"></div>
          <div class="absolute inset-x-5 bottom-5 flex items-center gap-2 text-sm font-medium text-white/90">
            <Icon name="map" size={16} />
            <span>{s.hero.basedIn}</span>
          </div>
        </div>

        <div class="floaty glass absolute -start-12 top-10 flex items-center gap-2.5 rounded-2xl !bg-bg-2/80 px-3.5 py-2.5" style="--d:0">
          <span class="grid size-8 place-items-center rounded-xl bg-[#02569B]/15 text-[#42A5F5]"><Icon name="flutter" size={17} /></span>
          <span class="text-sm font-semibold" dir="ltr">Flutter · Dart</span>
        </div>
        <div class="floaty glass absolute -end-10 top-[44%] flex items-center gap-2.5 rounded-2xl !bg-bg-2/80 px-3.5 py-2.5" style="--d:1">
          <span class="grid size-8 place-items-center rounded-xl bg-emerald-500/15 text-emerald-500"><Icon name="googleplay" size={15} /></span>
          <span class="text-sm leading-tight">
            <b class="block font-display text-base" dir="ltr">100K+</b>
            <span class="text-muted">{stats[2].label[lang]}</span>
          </span>
        </div>
        <div class="floaty glass absolute -start-10 bottom-20 flex items-center gap-2.5 rounded-2xl !bg-bg-2/80 px-3.5 py-2.5" style="--d:2">
          <span class="grid size-8 place-items-center rounded-xl bg-[#3DDC84]/15 text-[#3DDC84]"><Icon name="siAndroid" size={17} /></span>
          <span class="text-sm font-semibold" dir="ltr">Kotlin · Java</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Stats: 2 x 2 on phones, one row from tablets up -->
  <div class="container-x mt-7 sm:mt-14 lg:mt-24">
    <dl class="rise glass grid grid-cols-2 overflow-hidden rounded-[1.6rem] sm:rounded-[2rem] md:grid-cols-4" style="--d:4">
      {
        stats.map((st, i) => (
          <div
            class:list={[
              'relative flex flex-col px-5 py-4 sm:px-8 sm:py-8',
              i % 2 === 1 && 'border-s border-line',
              i >= 2 && 'border-t border-line md:border-t-0',
              i === 2 && 'md:border-s',
            ]}
          >
            <dt class="order-2 mt-1 text-[0.85rem] leading-snug text-muted sm:text-base">{st.label[lang]}</dt>
            <dd class="font-display text-[clamp(1.9rem,6vw,3.6rem)] font-bold leading-none tracking-tight">
              <bdi dir="ltr"><span data-count={st.value} data-locale="en">{fmt(st.value)}</span><span class="text-gradient">{st.suffix}</span></bdi>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
  <ProjectMarquee lang={lang} />
</section>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const nums = document.querySelectorAll<HTMLElement>('[data-count]');
  if (!reduce && !document.documentElement.classList.contains('shot') && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        io.unobserve(e.target);
        const el = e.target as HTMLElement;
        const target = Number(el.dataset.count);
        const fmt = new Intl.NumberFormat(el.dataset.locale);
        const t0 = performance.now();
        const dur = 1400;
        const tick = (now: number) => {
          const p = Math.min(1, (now - t0) / dur);
          const eased = 1 - Math.pow(1 - p, 4);
          el.textContent = fmt.format(Math.round(target * eased));
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
    }, { threshold: 0.6 });
    nums.forEach((n) => io.observe(n));
  }
</script>
