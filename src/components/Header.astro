---
import Icon from './Icon.astro';
import { t, url, type Lang } from '../i18n';
import { links, profile } from '../data/site';

interface Props {
  lang: Lang;
  path: string;
}
const { lang, path } = Astro.props;
const s = t(lang);
const other: Lang = lang === 'en' ? 'ar' : 'en';
const home = url(`${lang}/`);
const nav = [
  { href: `${home}#work`, label: s.nav.work },
  { href: `${home}#services`, label: s.nav.services },
  { href: `${home}#stack`, label: s.nav.stack },
  { href: `${home}#process`, label: s.nav.process },
  { href: `${home}#contact`, label: s.nav.contact },
];
---

<!--
  Phones and tablets: a compact, full-bleed app bar (navigation lives in the bottom bar).
  Desktop: the floating glass pill with the full menu.
-->
<header class="app-bar fixed inset-x-0 top-0 z-50 lg:pt-4" data-header>
  <div class="mx-auto lg:max-w-[80rem] lg:px-[var(--gutter)]">
    <nav
      class="bar glass flex items-center justify-between gap-3 max-lg:px-[var(--gutter)] lg:rounded-full lg:py-2 lg:ps-3 lg:pe-2"
      aria-label="Primary"
    >
      <a href={home} class="flex min-h-11 min-w-0 items-center gap-2.5 rounded-full pe-2" aria-label={profile.name[lang]}>
        <span
          class="relative grid size-9 shrink-0 place-items-center overflow-hidden rounded-full bg-[conic-gradient(from_200deg,#2563eb,#7c3aed,#06b6d4,#2563eb)] font-display text-[0.8125rem] font-bold text-white shadow-[0_6px_20px_-6px_rgb(79_70_229/.8)]"
        >
          <span class="relative z-10" dir="ltr">MS</span>
        </span>
        <span class="truncate font-display text-[1rem] font-semibold tracking-tight">{profile.name[lang]}</span>
      </a>

      <ul class="hidden items-center gap-1 lg:flex">
        {
          nav.map((n) => (
            <li>
              <a
                href={n.href}
                class="rounded-full px-3.5 py-2 text-[0.9rem] font-medium text-muted transition-colors hover:bg-glass-2 hover:text-ink"
              >
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex shrink-0 items-center gap-1">
        <a
          href={url(`${other}/${path}`)}
          hreflang={other}
          lang={other}
          data-lang-switch={other}
          class="inline-flex h-11 items-center gap-1.5 rounded-full px-3 text-[0.9rem] font-semibold text-ink-2 transition-colors hover:bg-glass-2 hover:text-ink"
          title={s.langSwitchLabel}
          aria-label={s.langSwitchLabel}
        >
          <Icon name="globe" size={18} />
          <span class="max-[380px]:hidden">{s.langSwitch}</span>
        </a>
        <button
          type="button"
          data-theme-toggle
          class="grid size-11 place-items-center rounded-full text-ink-2 transition-colors hover:bg-glass-2 hover:text-ink"
          aria-label={s.themeToggle}
          title={s.themeToggle}
        >
          <Icon name="sun" size={19} class="hidden dark:block" />
          <Icon name="moon" size={19} class="block dark:hidden" />
        </button>
        <a href={links.whatsapp} target="_blank" rel="noopener" class="btn btn-primary hidden !px-4 !py-2.5 text-sm lg:inline-flex">
          <Icon name="whatsapp" size={16} />
          <span>{s.hero.ctaPrimary}</span>
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  @media (max-width: 1023.98px) {
    .bar {
      min-height: calc(3.5rem + env(safe-area-inset-top));
      padding-top: env(safe-area-inset-top);
      border-width: 0 0 1px;
      border-radius: 0;
      box-shadow: none;
      background: color-mix(in oklab, var(--bg) 72%, transparent);
    }
  }
</style>
