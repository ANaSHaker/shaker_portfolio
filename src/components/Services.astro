---
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import { t, type Lang } from '../i18n';
import { profile, services } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const icons: Record<string, string> = { mobile: 'phone', product: 'layers', backend: 'code' };
const tints: Record<string, string> = { mobile: '#3b82f6', product: '#22c55e', backend: '#a855f7' };
---

<section id="services" class="section relative" aria-labelledby="services-title">
  <div class="container-x">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <SectionHead kicker={s.about.kicker} title={s.about.title} />
      </div>
      <div class="space-y-5 text-[1.05rem] leading-relaxed text-ink-2 sm:text-lg lg:col-span-7 lg:pt-12" data-reveal style="--d:1">
        {profile.bio[lang].map((p) => <p>{p}</p>)}
      </div>
    </div>

    <SectionHead kicker={s.services.kicker} title={s.services.title} id="services-title" class="mt-16 sm:mt-28" />

    <div class="scroll-row -mx-[var(--gutter)] mt-8 gap-4 px-[var(--gutter)] pb-2 sm:mt-12 md:mx-0 md:grid md:grid-cols-3 md:gap-5 md:overflow-visible md:px-0">
      {
        services.map((sv, i) => (
          <article class="card group flex w-[84%] flex-col p-6 sm:w-[58%] sm:p-8 md:w-auto" style={`--accent:${tints[sv.key]};--d:${i}`} data-reveal>
            <span
              class="grid size-13 place-items-center rounded-2xl border border-line"
              style={`color:${tints[sv.key]};background:color-mix(in oklab, ${tints[sv.key]} 14%, transparent);box-shadow:0 10px 30px -12px ${tints[sv.key]}`}
            >
              <Icon name={icons[sv.key]} size={24} />
            </span>
            <h3 class="mt-6 font-display text-2xl font-semibold tracking-tight">{sv.title[lang]}</h3>
            <p class="mt-3 leading-relaxed text-muted">{sv.lead[lang]}</p>
            <ul class="mt-6 flex flex-wrap gap-2 pt-1">
              {sv.items.map((it) => (
                <li class="chip" dir="auto">
                  {it}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
