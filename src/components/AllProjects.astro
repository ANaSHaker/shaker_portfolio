---
import ProjectCard from './ProjectCard.astro';
import Icon from './Icon.astro';
import { links } from '../data/site';
import SectionHead from './SectionHead.astro';
import { projects } from '../data/projects';
import { categories } from '../data/site';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const counts = Object.fromEntries(
  categories.map((c) => [c.key, c.key === 'all' ? projects.length : projects.filter((p) => p.categories.includes(c.key as any)).length]),
);
const countLabels = Object.fromEntries(categories.map((c) => [c.key, s.all.count(counts[c.key])]));
const fmt = (n: number) => String(n);
---

<section id="projects" class="relative py-24 sm:py-28" aria-labelledby="projects-title">
  <div class="container-x">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <SectionHead kicker={s.all.kicker} title={s.all.title} id="projects-title" />
      <p class="text-muted lg:pb-3" aria-live="polite" data-count-label data-labels={JSON.stringify(countLabels)}>
        {countLabels.all}
      </p>
    </div>

    <div class="-mx-4 mt-10 overflow-x-auto px-4 pb-2 [scrollbar-width:none]" data-reveal>
      <div class="flex w-max gap-2" role="group" aria-label={s.all.filter} data-filters>
        {
          categories.map((c, i) => (
            <button
              type="button"
              class="filter-btn inline-flex items-center gap-2 rounded-full border border-line bg-glass px-4 py-2.5 text-sm font-medium text-ink-2 transition-all hover:border-line-strong hover:text-ink"
              data-filter={c.key}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              {c.label[lang]}
              <span class="count rounded-full bg-glass-2 px-2 py-0.5 text-xs tabular-nums text-muted">{fmt(counts[c.key])}</span>
            </button>
          ))
        }
      </div>
    </div>

    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-grid>
      {projects.map((p, i) => <ProjectCard p={p} lang={lang} index={i} />)}
      <article class="card group relative flex flex-col justify-between overflow-hidden p-8 sm:col-span-2 sm:p-10" data-always data-reveal>
        <div
          class="pointer-events-none absolute -end-24 -top-24 size-80 rounded-full bg-[radial-gradient(closest-side,rgb(124_58_237/.35),transparent)] blur-2xl"
          aria-hidden="true"
        >
        </div>
        <span class="grid size-14 place-items-center rounded-2xl border border-line bg-glass-2 text-ink">
          <Icon name="github" size={26} />
        </span>
        <div class="relative mt-10">
          <h3 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">{s.all.moreTitle}</h3>
          <p class="mt-3 max-w-lg leading-relaxed text-muted">{s.all.moreBody}</p>
          <a
            href={links.github}
            target="_blank"
            rel="noopener"
            class="link-arrow mt-6 inline-flex items-center gap-2 font-semibold after:absolute after:inset-0"
            dir="ltr"
          >
            github.com/ANaSHaker
            <Icon name="arrow-up-right" size={18} />
          </a>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .filter-btn[aria-pressed='true'] {
    color: #fff;
    border-color: transparent;
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    box-shadow: 0 10px 26px -12px rgb(79 70 229 / 0.8);
  }
  .filter-btn[aria-pressed='true'] .count {
    background: rgb(255 255 255 / 0.2);
    color: #fff;
  }
  [data-grid] > :global(article.is-hidden) {
    display: none;
  }
</style>

<script>
  const wrap = document.querySelector<HTMLElement>('[data-filters]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-grid] > article')];
  const label = document.querySelector<HTMLElement>('[data-count-label]');
  const labels = JSON.parse(label?.dataset.labels ?? '{}');

  function apply(key: string, push = true) {
    wrap?.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === key)));
    const run = () => {
      cards.forEach((c) => {
        const show = c.hasAttribute('data-always') || key === 'all' || (c.dataset.categories ?? '').split(' ').includes(key);
        c.classList.toggle('is-hidden', !show);
        if (show) c.classList.add('is-in');
      });
      if (label) label.textContent = labels[key] ?? '';
    };
    const doc = document as Document & { startViewTransition?: (cb: () => void) => unknown };
    if (doc.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) doc.startViewTransition(run);
    else run();
    if (push) {
      const u = new URL(location.href);
      if (key === 'all') u.searchParams.delete('filter');
      else u.searchParams.set('filter', key);
      history.replaceState(null, '', u);
    }
  }

  wrap?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
    if (btn) apply(btn.dataset.filter!);
  });
  const initial = new URL(location.href).searchParams.get('filter');
  if (initial && wrap?.querySelector(`[data-filter="${CSS.escape(initial)}"]`)) apply(initial, false);
</script>
