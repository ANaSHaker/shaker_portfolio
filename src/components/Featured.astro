---
import ProjectCard from './ProjectCard.astro';
import SectionHead from './SectionHead.astro';
import { featured } from '../data/projects';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
---

<section id="work" class="section relative" aria-labelledby="work-title">
  <div class="container-x">
    <SectionHead kicker={s.featured.kicker} title={s.featured.title} id="work-title" />
    <div class="mt-10 grid gap-4 sm:mt-14 sm:gap-5 md:grid-cols-2 lg:gap-6">
      {featured.map((p, i) => <ProjectCard p={p} lang={lang} index={i} featured />)}
    </div>
  </div>
</section>
