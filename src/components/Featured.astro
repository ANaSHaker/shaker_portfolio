---
import Icon from './Icon.astro';
import Img from './Img.astro';
import Meta from './Meta.astro';
import SectionHead from './SectionHead.astro';
import { featured, bannerOf } from '../data/projects';
import { t, url, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
// Bento rhythm: big, small, small, big, small, small
const isBig = (i: number) => i % 3 === 0;
---

<section id="work" class="relative py-24 sm:py-32" aria-labelledby="work-title">
  <div class="container-x">
    <SectionHead kicker={s.featured.kicker} title={s.featured.title} id="work-title" />
    <div class="mt-14 grid gap-5 md:grid-cols-2">
      {
        featured.map((p, i) => {
          const banner = bannerOf(p);
          const href = url(`${lang}/projects/${p.slug}/`);
          return isBig(i) ? (
            <article
              class="card group relative grid overflow-hidden md:col-span-2 lg:grid-cols-12"
              style={`--accent:${p.accent}`}
              data-reveal
            >
              <div
                class="pointer-events-none absolute -top-48 start-[10%] size-[28rem] rounded-full opacity-20 blur-3xl"
                style={`background:${p.accent}`}
                aria-hidden="true"
              />
              <div class="relative flex flex-col p-7 sm:p-10 lg:col-span-5">
                <Meta p={p} lang={lang} />
                <h3 class="mt-6 font-display text-4xl font-bold tracking-tight sm:text-5xl">
                  <a href={href} class="after:absolute after:inset-0 focus-visible:outline-none">
                    {p.name[lang]}
                  </a>
                </h3>
                <p class="accent-text mt-3 font-display text-lg font-medium">{p.tagline[lang]}</p>
                <p class="mt-4 leading-relaxed text-muted">{p.summary[lang]}</p>
                {p.metrics.length > 0 && (
                  <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-5 border-t border-line pt-6">
                    {p.metrics.slice(0, 2).map((m) => (
                      <div class="flex flex-col">
                        <dt class="order-2 mt-1 text-sm leading-snug text-muted">{m.label[lang]}</dt>
                        <dd class="font-display text-3xl font-bold tracking-tight">
                          <bdi>{m.value}</bdi>
                        </dd>
                      </div>
                    ))}
                  </dl>
                )}
                <span class="link-arrow mt-auto inline-flex items-center gap-2 pt-8 font-semibold">
                  {s.featured.read}
                  <Icon name="arrow" size={18} class="flip-rtl" />
                </span>
              </div>
              <div class="relative flex items-center p-2.5 lg:col-span-7 lg:ps-0">
                <div class="media-zoom w-full overflow-hidden rounded-[1.35rem] border border-line bg-bg-2">
                  <Img
                    src={banner.src}
                    alt={banner.alt[lang]}
                    sizes="(min-width: 1024px) 760px, 100vw"
                    class="aspect-[2/1] w-full object-cover"
                  />
                </div>
              </div>
            </article>
          ) : (
            <article
              class="card group relative flex flex-col overflow-hidden p-2.5"
              style={`--accent:${p.accent};--d:${i % 3}`}
              data-reveal
            >
              <div class="media-zoom overflow-hidden rounded-[1.35rem] border border-line bg-bg-2">
                <Img
                  src={banner.src}
                  alt={banner.alt[lang]}
                  sizes="(min-width: 768px) 620px, 100vw"
                  class="aspect-[2/1] w-full object-cover"
                />
              </div>
              <div class="flex flex-1 flex-col p-5 sm:p-7">
                <Meta p={p} lang={lang} />
                <h3 class="mt-5 font-display text-3xl font-bold tracking-tight">
                  <a href={href} class="after:absolute after:inset-0 focus-visible:outline-none">
                    {p.name[lang]}
                  </a>
                </h3>
                <p class="accent-text mt-2 font-display font-medium">{p.tagline[lang]}</p>
                <p class="mt-3 leading-relaxed text-muted">{p.summary[lang]}</p>
                <span class="link-arrow mt-auto inline-flex items-center gap-2 pt-6 font-semibold">
                  {s.featured.read}
                  <Icon name="arrow" size={18} class="flip-rtl" />
                </span>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .accent-text {
    color: color-mix(in oklab, var(--accent) 72%, var(--ink));
  }
  .card:has(a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
</style>
