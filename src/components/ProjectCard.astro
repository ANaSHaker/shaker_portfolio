---
import Icon from './Icon.astro';
import Img from './Img.astro';
import type { Project } from '../data/types';
import { bannerOf } from '../data/projects';
import { t, url, type Lang } from '../i18n';

interface Props {
  p: Project;
  lang: Lang;
  index?: number;
}
const { p, lang, index = 0 } = Astro.props;
const s = t(lang);
const banner = bannerOf(p);
---

<article
  class="card group flex flex-col overflow-hidden p-2.5"
  style={`--accent:${p.accent};--d:${index % 3}`}
  data-categories={p.categories.join(' ')}
  data-reveal
>
  <div class="media-zoom relative overflow-hidden rounded-[1.35rem] border border-line bg-bg-2">
    <Img
      src={banner.src}
      alt={banner.alt[lang]}
      sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
      class="aspect-[2/1] w-full object-cover"
    />
  </div>
  <div class="flex flex-1 flex-col px-3.5 pb-4 pt-5">
    <div class="flex min-w-0 items-center gap-2 whitespace-nowrap text-xs font-medium text-muted">
      <span class="size-2 shrink-0 rounded-full" style={`background:${p.accent};box-shadow:0 0 10px ${p.accent}`}></span>
      <span>{s.kind[p.kind]}</span>
      {p.region && <span aria-hidden="true">·</span>}
      {p.region && <span class="min-w-0 truncate">{p.region[lang]}</span>}
    </div>
    <h3 class="mt-3 font-display text-xl font-semibold tracking-tight">
      <a href={url(`${lang}/projects/${p.slug}/`)} class="after:absolute after:inset-0 after:rounded-[1.75rem] focus-visible:outline-none">
        {p.name[lang]}
      </a>
    </h3>
    <p class="mt-2 line-clamp-3 text-[0.95rem] leading-relaxed text-muted">{p.summary[lang]}</p>
    <div class="mt-auto flex items-end justify-between gap-3 pt-5">
      <ul class="flex flex-wrap gap-1.5">
        {p.stack.slice(0, 3).map((x) => <li class="chip !px-2.5 !py-1 !text-[0.72rem]" dir="ltr">{x}</li>)}
      </ul>
      <span
        class="arrow-bubble grid size-10 shrink-0 place-items-center rounded-full border border-line text-ink-2 transition-colors duration-300"
        aria-hidden="true"
      >
        <Icon name="arrow-up-right" size={18} class="flip-rtl" />
      </span>
    </div>
  </div>
</article>

<style>
  .card:hover .arrow-bubble {
    background: var(--accent);
    border-color: transparent;
    color: #fff;
  }
  .card:has(a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
</style>
