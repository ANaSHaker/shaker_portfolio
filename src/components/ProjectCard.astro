---
import Img from './Img.astro';
import Flag from './Flag.astro';
import StoreLinks from './StoreLinks.astro';
import type { Project } from '../data/types';
import { bannerOf } from '../data/projects';
import { t, url, type Lang } from '../i18n';

interface Props {
  p: Project;
  lang: Lang;
  index?: number;
  /** Featured cards lead with the project banner. */
  featured?: boolean;
}
const { p, lang, index = 0, featured = false } = Astro.props;
const s = t(lang);
const banner = bannerOf(p);
const href = url(`${lang}/projects/${p.slug}/`);
const initial = p.name.en.trim()[0]?.toUpperCase() ?? '•';
---

<article
  class:list={['card project-card group flex flex-col overflow-hidden', featured ? 'p-2' : 'p-1.5']}
  style={`--accent:${p.accent};--d:${index % 3}`}
  data-categories={p.categories.join(' ')}
  data-reveal
>
  {
    featured && banner && (
      <div class="media-zoom relative overflow-hidden rounded-[1.4rem] border border-line bg-bg-2">
        <Img
          src={banner.src}
          alt={banner.alt[lang]}
          sizes="(min-width: 1280px) 620px, (min-width: 768px) 50vw, 100vw"
          class="aspect-[2/1] w-full object-cover"
        />
      </div>
    )
  }
  <div class:list={['flex flex-1 flex-col', featured ? 'px-3 pb-3 pt-4' : 'px-3 pb-3 pt-3.5']}>
    <div class="flex items-center gap-3.5">
      <span class="app-icon relative size-14 shrink-0 overflow-hidden rounded-[1.05rem] bg-bg-2" aria-hidden="true">
        {
          p.logo ? (
            <img src={url(p.logo)} alt="" width="56" height="56" loading="lazy" decoding="async" class="size-full object-cover" />
          ) : (
            <span class="grid size-full place-items-center font-display text-2xl font-bold text-white" style={`background:${p.accent}`}>
              {initial}
            </span>
          )
        }
      </span>
      <div class="min-w-0 flex-1">
        <h3 class="truncate font-display text-[1.2rem] font-semibold leading-tight tracking-tight">
          <a href={href} class="stretched focus-visible:outline-none">{p.name[lang]}</a>
        </h3>
        <div class="mt-1.5 flex min-w-0 items-center gap-2 text-[0.8125rem] font-medium text-muted">
          <Flag p={p} lang={lang} />
          {p.region && <span aria-hidden="true">·</span>}
          <span class="truncate">{s.kind[p.kind]}</span>
        </div>
      </div>
    </div>
    <p class="mt-3.5 line-clamp-2 text-[0.95rem] leading-relaxed text-ink-2">{p.tagline[lang]}</p>
    <StoreLinks p={p} lang={lang} class="mt-auto pt-4" />
  </div>
</article>

<style>
  .app-icon {
    box-shadow:
      0 0 0 1px var(--line-strong),
      0 10px 24px -12px color-mix(in oklab, var(--accent) 80%, transparent);
  }
  .stretched::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .project-card {
    border-radius: 1.75rem;
  }
  .card:has(.stretched:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
</style>
